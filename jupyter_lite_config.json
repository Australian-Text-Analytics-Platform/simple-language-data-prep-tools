{
  "LiteBuildConfig": {
    "contents": ["notebooks/"],
    "extra_ignore_contents": ["outputs", "__pycache__", "egg-info"],
    "output_dir": "docs"
  },
  "PyodideLockAddon": {
    "enabled": true,
    "specs": ["ipywidgets", "python-docx", "openpyxl"]
  },
  "PyodideLockOfflineAddon": {
    "enabled": true,
    "includes": ["ipywidgets", "python-docx", "openpyxl"],
    "prune": true
  }
}
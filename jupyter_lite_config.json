{
  "LiteBuildConfig": {
    "contents": ["notebooks/", "examples/"],
    "extra_ignore_contents": ["outputs", "__pycache__", "egg-info"],
    "output_dir": "docs"
  },
  "PyodideLockAddon": {
    "enabled": true,
    "specs": [
      "ipywidgets",
      "python-docx",
      "openpyxl",
      "widgetsnbextension",
      "jupyterlab-widgets",
      "pypdf",
      "fonttools"
    ],
    "prefetch_extra": ["ipywidgets", "python-docx", "openpyxl", "pypdf"]
  },
  "PyodideLockOfflineAddon": {
    "enabled": true,
    "includes": [
      "ipywidgets",
      "python-docx",
      "openpyxl",
      "widgetsnbextension",
      "jupyterlab-widgets",
      "pypdf",
      "fonttools"
    ],
    "prune": true
  }
}